{
  "name": "forwardauth-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Centralized ForwardAuth server for applications behind Traefik",
  "license": "MIT",
  "workspaces": [
    "frontend"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build --workspace frontend",
    "dev": "tsx watch src/server.ts",
    "dev:frontend": "npm run dev --workspace frontend",
    "start": "node dist/server.js",
    "test": "vitest run && npm run test --workspace frontend",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm run typecheck --workspace frontend"
  },
  "dependencies": {
    "argon2": "^0.44.0",
    "better-sqlite3": "^12.2.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "pg": "^8.16.3",
    "proxy-addr": "^2.0.7",
    "reflect-metadata": "^0.2.2",
    "typeorm": "^0.3.26",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^24.3.0",
    "@types/proxy-addr": "^2.0.3",
    "@types/supertest": "^6.0.3",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}

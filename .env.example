IMAGE_TAG=latest
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL=30d
SSO_MODE=cross-domain
COOKIE_NAME=coolify_auth
SSO_COOKIE_NAME=forwardauth_sso
APPLICATION_COOKIE_NAME=forwardauth_app
COOKIE_DOMAIN=
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
PUBLIC_URL=https://auth.example.com
AUTHORIZATION_CODE_TTL=60s
CALLBACK_PATH=/_forwardauth/callback
SIGNUP_ENABLED=false
ADMIN_UI_ENABLED=true
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-password
TRUSTED_PROXIES=loopback,linklocal,uniquelocal
LOG_LEVEL=info

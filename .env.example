IMAGE_TAG=latest
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL=30d
COOKIE_NAME=coolify_auth
COOKIE_DOMAIN=.example.com
PUBLIC_URL=https://auth.example.com
SIGNUP_ENABLED=false
ADMIN_UI_ENABLED=true

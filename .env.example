BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-password
ALLOWED_REDIRECTS=jellyfin.example.com,radarr.example.com,sonarr.example.com
TRUSTED_PROXIES=loopback,linklocal,uniquelocal
LOG_LEVEL=info
